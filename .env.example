# Shared integration environment. Never commit a real .env file.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# One PostgreSQL database for every service (schema ownership is separated by module).
DATABASE_URL=postgresql+asyncpg://platform_user:change-me@localhost:5432/samsungdb
DATABASE_URL_SYNC=postgresql://platform_user:change-me@localhost:5432/samsungdb
DB_SCHEMA_INGESTION=ingestion
DB_SCHEMA_SEARCH=search
DB_SCHEMA_ENRICHMENT=enrichment
DB_SCHEMA_AUDIT=audit

# Shared infrastructure.
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=multimodal_files

# Shared object storage. Supply credentials through the shell, secret manager, or CI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
USE_MOCK_S3=false

# Authentication and watermark signing; replace in every environment.
JWT_SECRET_KEY=replace-with-a-random-secret
WATERMARK_SECRET_KEY=replace-with-a-random-secret

# ── Production Search Service #2 (services/search/backend, port 8002) ─────────
SEARCH_PORT=8002
SEARCH_DATABASE_URL=sqlite+aiosqlite:///./services/search/backend/multimodal_search.db
# PostgreSQL (docker): postgresql+asyncpg://postgres:postgrespassword@localhost:5433/multimodal_search
SEARCH_QDRANT_HOST=localhost
SEARCH_QDRANT_PORT=6333
SEARCH_QDRANT_EMBEDDED=True
SEARCH_QDRANT_STORAGE_PATH=./services/search/backend/qdrant_storage
SEARCH_REDIS_HOST=localhost
SEARCH_REDIS_PORT=6379
SEARCH_REDIS_FALLBACK_MEMORY=True
SEARCH_AUTH_SECRET_KEY=replace-with-a-random-secret
SEARCH_EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32
