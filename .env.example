# ==============================================================================
# AWS S3 & RDS PostgreSQL Gateway Configuration
# ==============================================================================

# Cryptographic Secret for HMAC-SHA256 Signatures
WATERMARK_SECRET_KEY=ENTERPRISE_SECURE_HMAC_KEY_2026_AGY

# Experimental native JPEG DCT watermark (install requirements-codec.txt).
JPEG_CODEC_WATERMARK=false
LOSSLESS_SIGNAL_WATERMARK=false
NATIVE_AUDIO_WATERMARK=false
NATIVE_VIDEO_WATERMARK=false
# Use a separate private random secret, at least 32 bytes. Required when enabled.
CODEC_WATERMARK_SECRET=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIASM7...
AWS_SECRET_ACCESS_KEY=pLIiKoh...
AWS_REGION=ap-south-1
S3_BUCKET_NAME=demo-bucket-prism
USE_MOCK_S3=false

# ==============================================================================
# AWS RDS PostgreSQL / Aurora Configuration
# Option 1: Individual RDS fields (Recommended)
# ==============================================================================
AWS_RDS_HOST=mydb-instance.c123456789.ap-south-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_USER=postgres
AWS_RDS_PASSWORD=YourSecureRDSPassword
AWS_RDS_DB=watermark_db
AWS_RDS_SSLMODE=require

# Option 2: Complete Connection String (Alternative)
# DATABASE_URL=postgresql://postgres:YourSecureRDSPassword@mydb-instance.c123456789.ap-south-1.rds.amazonaws.com:5432/watermark_db?sslmode=require

# ==============================================================================
# Server Host & Port
# ==============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
