# Multimodal Search Backend Configuration
APP_NAME=Multimodal Search API
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Dev/test only - no real connection pooling, no GIN/full-text indexing:
DATABASE_URL=sqlite+aiosqlite:///./multimodal_search.db
# Production (required when APP_ENV=production - startup will refuse to run
# on SQLite otherwise, see app/db/postgres.py):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multimodal_search
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=True
# Disable once a real migration tool (Alembic) owns schema changes:
DB_AUTO_CREATE_SCHEMA=True

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=multimodal_files
# Embedded (local file) Qdrant - dev only. Cannot shard/replicate/cluster.
# Startup refuses to run with QDRANT_EMBEDDED=True when APP_ENV=production.
QDRANT_EMBEDDED=True
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_PREFER_GRPC=True
QDRANT_TIMEOUT_SECONDS=10
# Set True only for Qdrant Cloud or a TLS-terminated server - a self-hosted
# Qdrant with an API key but no TLS in front of it needs this False.
QDRANT_HTTPS=False

# Qdrant HNSW / collection topology - decide shard/replication before the
# first production ingest, shard_number can't be changed without recreating
# the collection. See the Qdrant capacity-planning doc §1-§4 for the numbers.
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_HNSW_EF_SEARCH=128
QDRANT_FULL_SCAN_THRESHOLD=10000
QDRANT_ON_DISK_VECTORS=False
QDRANT_SHARD_NUMBER=6
QDRANT_REPLICATION_FACTOR=2

# Bundled sample/demo dataset. Must be explicitly enabled AND non-production;
# never triggers automatically just because a collection/table is empty.
SEED_SAMPLE_DATA=False

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# If Redis is unreachable: True = degrade to a per-process in-memory cache
# (logged at ERROR, alertable) and keep serving; False = hard-fail with 503.
REDIS_FALLBACK_MEMORY=True

# Search & Ranking Configuration
RRF_K=60
RRF_KEYWORD_WEIGHT=0.5
RRF_VECTOR_WEIGHT=0.5
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32
VECTOR_DIMENSION=512

# Downstream Service Mock / Integrations
DOWNLOAD_AUDITING_SERVICE_URL=http://localhost:8001/api/v1/audit
AUTH_SECRET_KEY=multimodal-search-secure-jwt-secret-key-2025
