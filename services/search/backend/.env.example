# Multimodal Search Backend Configuration
APP_NAME=Multimodal Search API
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8002

# Database Configuration (Supports PostgreSQL, with SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./multimodal_search.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multimodal_search

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=multimodal_files
# Set to True to use embedded in-memory / local disk Qdrant (works without docker daemon)
QDRANT_EMBEDDED=True
QDRANT_STORAGE_PATH=./qdrant_storage

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Set to True to use fast in-memory LRU/TTL cache fallback when Redis is unavailable
REDIS_FALLBACK_MEMORY=True

# Search & Ranking Configuration
RRF_K=60
RRF_KEYWORD_WEIGHT=0.5
RRF_VECTOR_WEIGHT=0.5
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/clip-ViT-B-32
VECTOR_DIMENSION=512

# Downstream Service Mock / Integrations
DOWNLOAD_AUDITING_SERVICE_URL=http://localhost:8001/api/v1/audit
AUTH_SECRET_KEY=multimodal-search-secure-jwt-secret-key-2025
