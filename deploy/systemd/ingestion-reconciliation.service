[Unit]
Description=Data Ingestion Reconciliation Sweep
After=network.target postgresql.service

[Service]
Type=oneshot
User=ingestion
Group=ingestion
WorkingDirectory=/opt/ingestion
EnvironmentFile=/etc/ingestion/ingestion.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ingestion/venv/bin/python scripts/run_reconciliation.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ingestion-reconciliation
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
