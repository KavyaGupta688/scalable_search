POSTGRES_PASSWORD=replace-with-local-secret
INTERNAL_JWT_SECRET=replace-with-at-least-32-random-characters
NEXUS_JWT_SECRET=replace-with-another-32-random-characters
WATERMARK_SECRET_KEY=replace-with-another-private-key
VAULT_TOKEN=replace-with-local-vault-token
BOOTSTRAP_ADMIN_EMAIL=admin@platform.internal
BOOTSTRAP_ADMIN_PASSWORD=replace-before-starting
# Optional shared RDS identity database. Blank uses the configured runtime database.
# Teammates sharing sessions must use the same securely distributed NEXUS_JWT_SECRET.
AUTH_DATABASE_URL_SYNC=
# Maximum time allowed between ingestion Kafka polls during a source checksum read.
INGESTION_MAX_POLL_INTERVAL_MS=7200000

# Download limits (bytes). Search plans downloads against these and Download enforces them.
# DOWNLOAD_MAX_FILE_BYTES  largest single file; larger files are left out of a selection (default 128 MiB)
# DOWNLOAD_MAX_BATCH_BYTES size of ONE archive part; bigger requests are split into parts (default 2 GiB).
#                          Browsers hold a part in memory while saving it: 512 MiB - 1 GiB is gentler.
# DOWNLOAD_MAX_FILES       files per request (default 10000)
# DOWNLOAD_MAX_TOTAL_BYTES bytes per request across all parts (default 20 GiB). The /packages volume
#                          must hold at least this much per request being prepared, plus finished
#                          archives, which are kept for one day.
