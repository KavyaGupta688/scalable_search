FROM python:3.11-slim

WORKDIR /app

# System-level deps needed for model processing:
# ffmpeg   - video keyframe extraction, audio handling
# libgl1   - required by opencv/paddleocr for image processing
# libglib2.0-0 - required by opencv
RUN apt-get update && apt-get install -y ffmpeg libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .