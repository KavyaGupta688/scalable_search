# PostgreSQL URLs should use the matching SQLAlchemy driver and TLS.
DATABASE_URL=postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@RDS_HOST:5432/DATABASE?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@RDS_HOST:5432/DATABASE?sslmode=require

REDIS_URL=rediss://:URL_ENCODED_PASSWORD@REDIS_HOST:6379/0
CELERY_BROKER_URL=rediss://:URL_ENCODED_PASSWORD@REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=rediss://:URL_ENCODED_PASSWORD@REDIS_HOST:6379/1
EVENT_REDIS_URL=rediss://:URL_ENCODED_PASSWORD@REDIS_HOST:6379/2
CELERY_VISIBILITY_TIMEOUT=7200
CELERY_RESULT_EXPIRES=3600
QDRANT_URL=https://QDRANT_CLUSTER_HOST
QDRANT_API_KEY=replace-me
# Keep false for cloud environments; provision the collection deliberately.
QDRANT_CREATE_COLLECTION_IF_MISSING=false
RAM_CHECKPOINT_PATH=./checkpoints/ram_plus_swin_large_14m.pth
# yolov8s is more accurate than yolov8n; use yolov8n.pt for lower-resource machines.
YOLO_MODEL_NAME=yolov8s.pt

# MinIO object storage. storage_path accepts s3://bucket/object or bucket/object.
MINIO_ENDPOINT=your-cloud-minio-host:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=true

# Ingestion-owned table mapping. Replace these with the cloud schema names.
SOURCE_DOCUMENT_SCHEMA=public
SOURCE_DOCUMENT_TABLE=documents
SOURCE_DOCUMENT_ID_COLUMN=id
SOURCE_STORAGE_PATH_COLUMN=storage_path
SOURCE_FILE_TYPE_COLUMN=file_type
SOURCE_CHECKSUM_COLUMN=checksum
SOURCE_METADATA_COLUMN=source_metadata

# Docker Compose uses service hostnames rather than localhost. Copy
# .env.docker.example to .env.docker; do not put secrets in either example.
