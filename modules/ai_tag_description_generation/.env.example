# PostgreSQL URLs should use the matching SQLAlchemy driver and TLS.
DATABASE_URL=postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@RDS_HOST:5432/DATABASE?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@RDS_HOST:5432/DATABASE?sslmode=require

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAM_CHECKPOINT_PATH=./checkpoints/ram_plus_swin_large_14m.pth

# MinIO object storage. storage_path accepts s3://bucket/object or bucket/object.
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=true
